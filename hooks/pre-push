#!/bin/sh
# Before every push, check what Netlify is about to build, so mistakes show up
# here with a file and line number instead of as a failed deploy. Drafts are
# only checked for conflict markers; they are never built.
# ./build.sh switches this on (git config core.hooksPath hooks).
# Skip it once with:  git push --no-verify
cd "$(git rev-parse --show-toplevel)" || exit 1

# Leftover merge-conflict markers are not always Typst errors (a line of =
# signs is a heading), so they could otherwise be published as text.
if git grep -n -E '^(<<<<<<<|>>>>>>>)( |$)|^=======$' -- '*.typ' >&2; then
    echo "pre-push: merge-conflict markers above; resolve them before pushing." >&2
    exit 1
fi

if [ -n "$(git status --porcelain -- posts index.typ theme.typ site.typ)" ]; then
    echo "pre-push: note: checking your working copy, which has uncommitted changes." >&2
fi

out=$(mktemp -d) || exit 1
if ! ./build.sh "$out" >/dev/null 2>"$out.log"; then
    echo "pre-push: the site does not build, so the push was stopped:" >&2
    grep -v -E "^ *= hint|bundle export is experimental" "$out.log" >&2
    rm -rf "$out" "$out.log"
    exit 1
fi
rm -rf "$out" "$out.log"
